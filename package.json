{
  "name": "groundtruth",
  "private": true,
  "version": "0.1.0",
  "description": "Browser open-world game: take down surveillance cameras in photoreal 3D versions of real US places, compiled at runtime from OpenStreetMap and open terrain data.",
  "license": "MIT",
  "author": "Benjamin Life",
  "homepage": "https://omniharmonic.github.io/FLKVI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omniharmonic/FLKVI.git"
  },
  "bugs": {
    "url": "https://github.com/omniharmonic/FLKVI/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:fast": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "compile:city": "node --experimental-strip-types tools/compile-city.ts",
    "check:licenses": "node --experimental-strip-types tools/check-licenses.ts",
    "test:ai": "node --experimental-strip-types src/ai/tests/sim.test.ts",
    "test:browser": "bash tools/check-game.sh",
    "test:world": "bash tools/check-world.sh",
    "test:deep": "node --experimental-strip-types tools/deep-regressions.ts",
    "test:integration": "bash tools/check-deep.sh",
    "test:collisions": "bash tools/check-collisions.sh",
    "test:streaming": "bash tools/check-streaming.sh",
    "test:stability": "node --experimental-strip-types tools/streaming-continuation-regressions.ts && node --experimental-strip-types tools/compiler-identity-regressions.ts && node --experimental-strip-types tools/render-budget-regressions.ts",
    "test:streaming:extended": "bash tools/check-streaming-overhaul.sh",
    "test:soak": "bash tools/check-world-soak.sh"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "leaflet": "^1.9.4",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
